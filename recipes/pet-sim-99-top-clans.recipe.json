{
  "recipe": 1,
  "name": "Pet Sim 99 top clans",
  "credit": "Data from Big Games' public Pet Simulator 99 API.",
  "everySeconds": 300,
  "steps": [
    {
      "url": "https://ps99.biggamesapi.io/api/activeClanBattle",
      "take": {
        "battle": "data.configName",
        "battleStarts": "data.configData.StartTime",
        "battleEnds": "data.configData.FinishTime"
      },
      "idleWithout": "battle",
      "idleMessage": "No clan battle running"
    },
    {
      "url": "https://ps99.biggamesapi.io/v1/clans/battles/{battle}",
      "rows": "data.topClans",
      "groupName": "name",
      "rank": "rank",
      "values": [
        {
          "id": "points",
          "label": "Points",
          "path": "points",
          "metricId": "clan.battle.points"
        },
        {
          "id": "members",
          "label": "Members",
          "path": "members",
          "metricId": "clan.members"
        },
        {
          "id": "capacity",
          "label": "Member capacity",
          "path": "memberCapacity",
          "metricId": "clan.member.capacity"
        },
        {
          "id": "contributors",
          "label": "Contributors",
          "path": "contributorCount",
          "metricId": "clan.battle.contributors"
        }
      ]
    }
  ],
  "period": {
    "value": "battle",
    "starts": "battleStarts",
    "ends": "battleEnds"
  }
}
