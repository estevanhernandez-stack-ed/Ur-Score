<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>626labs.ur-score</AssemblyName>
    <RootNamespace>Labs626.UrScore</RootNamespace>
    <Version>0.6.2</Version>
    <Company>626 Labs LLC</Company>
    <Product>RoRoRo Ur Score</Product>
    <Description>Reads your accounts' numbers from wherever a recipe says, keeps them on your scoreboard and in your score book, and hands them to RoRoRo.</Description>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <IntermediateOutputPath Condition="'$(IntermediateOutputPath)' == ''">$(BaseIntermediateOutputPath)$(Configuration)\</IntermediateOutputPath>
    <IntermediateOutputPath>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)', '$(MSBuildProjectDirectory)'))</IntermediateOutputPath>
    <!-- Made by build/make-icon.py from the same art as icon.png. WPF windows with no Icon of their
         own use the EXE's, so this one line gives the title bar, taskbar and Alt+Tab the icon. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The recipes ship inside the binary as well as beside the release, so a first run needs no download.
       Same files either way, so BuiltInRecipes and the release can never drift. -->
  <ItemGroup>
    <EmbeddedResource Include="recipes\*.recipe.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ROROROblox.PluginContract" Version="0.10.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.70.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ur-Score.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/ has its own csproj; keep the EXE's implicit glob out of it. -->
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- App.xaml lives under src/; the default ApplicationDefinition glob only covers the root. -->
    <ApplicationDefinition Remove="**/App.xaml" />
    <ApplicationDefinition Include="src\App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
  </ItemGroup>

  <!-- V3-S.39, root-caused 2026-09-21 after four cycles lost to it, and reproduced deliberately at about one
       build in six (rewrite a source file with genuinely changed content, then run dotnet test).

       WPF compiles a XAML-bearing project a second time through a generated Ur-Score_<hash>_wpftmp.csproj and
       its own copy of the NuGet props. At the end of the pass MSBuild deletes both. When that delete loses a
       race the build fails with MSB3061, "unable to delete obj\Ur-Score_<hash>_wpftmp.csproj.nuget.g.props ...
       because it is being used by another process" - which at least names itself.

       The failure people actually see is the NEXT build. It finds those files left behind, markup generation
       does not run, App.g.cs never appears, and the compiler reports CS5001, "no static Main": an error naming
       neither XAML nor a lock, which reads as though the application source is broken when nothing in it
       changed. That is what cost the cycles - not the race, but the confusing error the race leaves behind.

       So this clears the leftovers at the start of every build, which breaks the chain: a lost race now costs
       one legible MSB3061 instead of a mystery on the following build. ContinueOnError because a file still
       held is exactly the case this exists for, and failing here would trade one confusing error for another.

       It is a mitigation, and the cure is in Directory.Build.props. The holder turned out to be C# Dev Kit's
       design-time build, run on every save through its own MSBuild nodes in the same obj\ - confirmed from the
       process tree after an on-access-scanning theory, and the obj exclusion it led to, had not closed it. The
       props file moves design-time intermediates to obj\designtime\, so the two builds no longer share files;
       this target stays because a leftover from any other cause is still cleared before it can confuse anyone.

       Ruled out, and checked rather than assumed: IncludePackageReferencesDuringMarkupCompilation=false would
       remove the .nuget.g.props from the dance entirely, but it also drops source generators from the markup
       pass, and this project's [GeneratedRegex] partials then fail with CS8795. -->
  <Target Name="ClearStaleWpfTempFiles" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <StaleWpfTemp Include="$(MSBuildProjectDirectory)\*_wpftmp.csproj" />
      <StaleWpfTemp Include="$(IntermediateOutputPath)*_wpftmp.*" />
      <StaleWpfTemp Include="$(BaseIntermediateOutputPath)*_wpftmp.*" />
    </ItemGroup>
    <Delete Files="@(StaleWpfTemp)" ContinueOnError="true" />
  </Target>

</Project>
