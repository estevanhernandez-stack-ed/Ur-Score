<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- ROROROblox.PluginContract 0.10.0 is the version that first carries ReportMetric and is
         NOT on nuget.org (which holds 0.9.0). It is packed locally from the host repo:
           dotnet pack src/ROROROblox.PluginContract/ROROROblox.PluginContract.csproj \
             -c Release -o ../.local-nuget
         Publishing 0.10.0 is deferred until this plugin is built, because nuget.org versions are
         immutable. When it is published, DELETE the local-contract source below and nothing else
         changes — the reference is already by package at the same version. -->
    <add key="local-contract" value="../.local-nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
