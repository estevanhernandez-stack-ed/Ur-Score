<UserControl x:Class="Labs626.UrScore.UI.AccountCardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Labs626.UrScore.UI">
    <Border Style="{StaticResource PanelCard}">
        <StackPanel>
            <ui:PanelFrame DataContext="{Binding Head}" />
            <StackPanel Margin="0,10,0,0" Visibility="{Binding Head.HasBody, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="{Binding BigLabel}" Style="{StaticResource KeyLabel}" />
                <TextBlock Text="{Binding Big}" Style="{StaticResource BigNumber}" Margin="0,5,0,-5" />
                <ui:LineChart Height="48" Margin="0,10,0,0" Series="{Binding Line}" FromZero="False" ShowLabels="False"
                              AutomationProperties.Name="{Binding ChartName}" />
                <!-- Sections sit side by side when the card is wide enough: each at least 200 wide, 24 apart. The list's -24
                     right margin takes the last section's trailing gap, so three fit where three widths and two gaps do. -->
                <ui:RowList ItemsSource="{Binding Sections}" Margin="0,10,-24,0" AutomationProperties.Name="This account's stats">
                    <ui:RowList.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ui:RowList.ItemsPanel>
                    <ui:RowList.ItemTemplate>
                        <DataTemplate>
                            <StackPanel MinWidth="200" Margin="0,0,24,10">
                                <!-- A section heading reads as a table heading, lined up with the facts under it. -->
                                <Border Style="{StaticResource PanelTableHeadingRow}" Padding="0,5"
                                        Visibility="{Binding HasHeading, Converter={StaticResource BoolToVisible}}">
                                    <TextBlock Text="{Binding Heading}" Style="{StaticResource ColumnHeader}" />
                                </Border>
                                <ui:RowList ItemsSource="{Binding Facts}">
                                    <ui:RowList.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,10,0,0">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource KeyValue}" Margin="16,0,0,0" />
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource KeyLabel}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ui:RowList.ItemTemplate>
                                </ui:RowList>
                            </StackPanel>
                        </DataTemplate>
                    </ui:RowList.ItemTemplate>
                </ui:RowList>
                <ui:RowList ItemsSource="{Binding Facts}">
                    <ui:RowList.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,12,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource KeyValue}" TextWrapping="Wrap" MaxWidth="220"
                                           TextAlignment="Right" />
                                <TextBlock Text="{Binding Label}" Style="{StaticResource KeyLabel}" />
                            </DockPanel>
                        </DataTemplate>
                    </ui:RowList.ItemTemplate>
                </ui:RowList>
            </StackPanel>
            <TextBlock x:Name="PanelNote" Text="{Binding Head.Note}" Style="{StaticResource PanelNoteText}"
                       Visibility="{Binding Head.HasNote, Converter={StaticResource BoolToVisible}}" />
        </StackPanel>
    </Border>
</UserControl>
