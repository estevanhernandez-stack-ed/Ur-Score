<UserControl x:Class="Labs626.UrScore.UI.PanelFrame"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Labs626.UrScore.Core">
    <StackPanel>
        <!-- Edit mode. Moving is dragging the header and sizing is hauling an edge, so neither has a button any more;
             what is left has no gesture of its own. Both are still reachable from the keyboard on the focused panel
             (BoardWindow.Editing.OnBoardKeyDown), which is how a board is arranged without a mouse and how the smoke
             walks arrange one at all. -->
        <WrapPanel x:Name="EditTools" Margin="0,0,0,8" Visibility="Collapsed">
            <Label x:Name="DragHandle" Background="Transparent" Cursor="SizeAll" Padding="6,3" VerticalAlignment="Center"
                   MinWidth="24" MinHeight="24" Focusable="False"
                   MouseLeftButtonDown="OnDragHandleDown" ToolTip="Drag to move"
                   AutomationProperties.AutomationId="DragHandle" AutomationProperties.Name="Drag to move">
                <UniformGrid Rows="3" Columns="2" Width="8" Height="12" IsHitTestVisible="False">
                    <Ellipse Width="2" Height="2" Fill="{DynamicResource MutedTextBrush}" />
                    <Ellipse Width="2" Height="2" Fill="{DynamicResource MutedTextBrush}" />
                    <Ellipse Width="2" Height="2" Fill="{DynamicResource MutedTextBrush}" />
                    <Ellipse Width="2" Height="2" Fill="{DynamicResource MutedTextBrush}" />
                    <Ellipse Width="2" Height="2" Fill="{DynamicResource MutedTextBrush}" />
                    <Ellipse Width="2" Height="2" Fill="{DynamicResource MutedTextBrush}" />
                </UniformGrid>
            </Label>
            <Button x:Name="RemovePanelButton" Content="✕" Tag="Remove" Style="{StaticResource FlatButton}" Padding="6,2"
                    Click="OnToolClick" />
        </WrapPanel>
        <!-- The title line (the mock's .p-head): title, chip and tools centred on one line; the tools in the muted text colour. -->
        <!-- Background, not the default null: a DockPanel with no brush is hit-test invisible over its empty space,
             so without this a press between the title and the tools would fall through and the header would only
             drag where there happens to be text. -->
        <DockPanel x:Name="TitleRow" LastChildFill="False" Background="Transparent"
                   MouseLeftButtonDown="OnTitleRowDown" MouseMove="OnTitleRowMove" MouseLeftButtonUp="OnTitleRowUp">
            <StackPanel x:Name="PanelTools" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Both are named in UpdateTools from the panel's own title ("Pop out Past battles"), so five panels
                     don't give a screen reader five identical buttons; no name here, which would go stale beside it. -->
                <Button x:Name="PopOutButton" Content="⧉" Tag="PopOut" Style="{StaticResource FlatButton}" Padding="6,2" Visibility="Collapsed"
                        Foreground="{DynamicResource MutedTextBrush}" Click="OnToolClick" />
                <Button x:Name="PanelSettingsButton" Content="⋯" Tag="Settings" Style="{StaticResource FlatButton}" Padding="6,2" Visibility="Collapsed"
                        Foreground="{DynamicResource MutedTextBrush}" Click="OnToolClick" />
            </StackPanel>
            <TextBlock x:Name="PanelTitle" DockPanel.Dock="Left" Text="{Binding Title, Converter={StaticResource Upper}}"
                       AutomationProperties.Name="{Binding Title}" Style="{StaticResource PanelTitleText}" />
            <!-- The chip (the mock's .chip): a pill whose edge is the source's role (PanelHead.ChipRole), never its words: your
                 main on the interactive edge, a clan your accounts are in cyan, a watched one magenta. Its text is always white,
                 which small role-coloured text isn't in every theme (magenta measured under 4.5:1). -->
            <Border DockPanel.Dock="Left" Margin="8,0,0,0" Padding="7,3" CornerRadius="999" BorderThickness="1" VerticalAlignment="Center"
                    Visibility="{Binding HasChip, Converter={StaticResource BoolToVisible}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ChipRole}" Value="{x:Static core:SourceRole.Main}">
                                <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ChipRole}" Value="{x:Static core:SourceRole.Mine}">
                                <Setter Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ChipRole}" Value="{x:Static core:SourceRole.Watch}">
                                <Setter Property="BorderBrush" Value="{DynamicResource MagentaBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Chip}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource WhiteBrush}" />
            </Border>
            <TextBlock x:Name="PanelOverdue" DockPanel.Dock="Left" Text="overdue" Margin="8,0,0,0" FontSize="11"
                       VerticalAlignment="Center" Foreground="{DynamicResource MagentaBrush}"
                       Visibility="{Binding Overdue, Converter={StaticResource BoolToVisible}}" />
            <!-- Plan A41: this panel's numbers came from the score book, not from a read this session. Muted, never
                 magenta: magenta is "overdue", which is a read that should have happened and hasn't. -->
            <TextBlock x:Name="PanelRemembered" DockPanel.Dock="Left" Text="remembered" Margin="8,0,0,0" FontSize="11"
                       VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                       Visibility="{Binding Remembered, Converter={StaticResource BoolToVisible}}" />
        </DockPanel>
        <TextBlock x:Name="PanelSubtitle" Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"
                   Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisible}}" />
        <TextBlock x:Name="PanelStale" Text="{Binding Stale}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Visibility="{Binding HasStale, Converter={StaticResource BoolToVisible}}" />
        <Button x:Name="ChooseAnotherButton" Content="Choose another" Tag="ChooseAnother" Style="{StaticResource FlatButton}"
            HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed" Click="OnToolClick" />
    </StackPanel>
</UserControl>
