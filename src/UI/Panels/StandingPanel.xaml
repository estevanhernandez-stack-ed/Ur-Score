<UserControl x:Class="Labs626.UrScore.UI.StandingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Labs626.UrScore.UI"
             xmlns:book="clr-namespace:Labs626.UrScore.Book">
    <Border Style="{StaticResource PanelCard}">
        <StackPanel>
            <ui:PanelFrame DataContext="{Binding Head}" />
            <!-- The mock's rhythm: 10 px between parts; key-value lines 12 apart, which at WPF's shorter line comes close to its 29 px pitch. -->
            <StackPanel Margin="0,10,0,0" Visibility="{Binding Head.HasBody, Converter={StaticResource BoolToVisible}}">
                <DockPanel>
                    <!-- The logo of the clan THIS panel is about, never the window's (backlog V3-S.7): a panel pinned to a watched clan
                         shows that clan's. Beside the place, as a picture sits beside the big number on the account card, and sized to
                         the number's 30 px box. While the picture isn't there yet, or doesn't decode, the slot is laid out anyway
                         (Hidden, never Collapsed: A26), so the place doesn't move when it lands; only a recipe that names no icon at
                         all gives it no slot. That trigger is last, because the later of two matching triggers wins. -->
                    <Image x:Name="StandingIcon" DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="{Binding Icon, Converter={StaticResource Picture}}"
                           AutomationProperties.Name="{Binding IconName}">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,30,30" RadiusX="6" RadiusY="6" />
                        </Image.Clip>
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Icon, Converter={StaticResource Picture}}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasIconSlot}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Place}" Style="{StaticResource BigNumber}" />
                        <TextBlock Text="{Binding PlaceSuffix}" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Bottom" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Total}" Style="{StaticResource KeyValue}" />
                    <TextBlock Text="{Binding TotalLabel}" Style="{StaticResource KeyLabel}" />
                </DockPanel>
                <StackPanel Margin="0,12,0,0" Visibility="{Binding HasGap, Converter={StaticResource BoolToVisible}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Gap}" Style="{StaticResource KeyValue}" Foreground="{DynamicResource MagentaBrush}" />
                        <TextBlock Text="{Binding GapLabel}" Style="{StaticResource KeyLabel}" />
                    </DockPanel>
                    <ui:FillBar Value="{Binding GapFill}" Margin="0,4,0,0" />
                </StackPanel>
                <DockPanel Margin="0,12,0,0" Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisible}}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Accounts}" Style="{StaticResource KeyValue}" />
                    <TextBlock Text="Your accounts" Style="{StaticResource KeyLabel}" />
                </DockPanel>
                <DockPanel Margin="0,12,0,0">
                    <!-- The colour follows which way the change went (backlog S1-13.14): cyan, this app's good news, only for a rise;
                         magenta, its warning, for a fall; the text colour for no change or none known. The words carry the sign
                         ("+1M", "-1M"), so the colour is never the only way to tell. -->
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Change}" FontWeight="Normal">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource KeyValue}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChangeDirection}" Value="{x:Static book:ChangeDirection.Up}">
                                        <Setter Property="Foreground" Value="{DynamicResource CyanBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ChangeDirection}" Value="{x:Static book:ChangeDirection.Down}">
                                        <Setter Property="Foreground" Value="{DynamicResource MagentaBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Change" Style="{StaticResource KeyLabel}" />
                </DockPanel>
                <!-- The battle's name, then how long it has left to the second and when it ends, ticking between reads. -->
                <ui:CountdownText Lead="{Binding PeriodLine}" Ends="{Binding Ends}" Style="{StaticResource Muted}" FontSize="11"
                                  TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
            <TextBlock x:Name="PanelNote" Text="{Binding Head.Note}" Style="{StaticResource PanelNoteText}"
                       Visibility="{Binding Head.HasNote, Converter={StaticResource BoolToVisible}}" />
        </StackPanel>
    </Border>
</UserControl>
