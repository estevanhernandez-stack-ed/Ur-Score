<UserControl x:Class="Labs626.UrScore.UI.RacePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Labs626.UrScore.UI">
    <Border Style="{StaticResource PanelCard}">
        <StackPanel>
            <ui:PanelFrame DataContext="{Binding Head}" />
            <StackPanel Margin="0,10,0,0" Visibility="{Binding Head.HasBody, Converter={StaticResource BoolToVisible}}">
                <!-- Taller since the board joined the chart, and the axis follows the data rather than zero when it does. -->
                <ui:LineChart Height="240" Series="{Binding Series}" FromZero="{Binding FromZero}" ShowLabels="True"
                              AutomationProperties.Name="{Binding ChartName}" />
                <ui:RowList ItemsSource="{Binding Legend}" Margin="0,8,0,0">
                    <ui:RowList.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ui:RowList.ItemsPanel>
                    <ui:RowList.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                <ui:LegendSwatch Colour="{Binding Colour}" />
                                <TextBlock Text="{Binding Text}" Style="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ui:RowList.ItemTemplate>
                </ui:RowList>
                <!-- The names live here, not on the chart: seven lines is as many as can be told apart, and the board
                     is twenty-five. Shut until asked for, so the card stays a chart. -->
                <StackPanel x:Name="StandingsRow" Orientation="Horizontal" Margin="0,4,0,0"
                            Visibility="{Binding HasStandings, Converter={StaticResource BoolToVisible}}">
                    <Button x:Name="StandingsButton" Content="Standings" Style="{StaticResource FlatButton}" Padding="0,2"
                            Click="OnStandingsClick" AutomationProperties.Name="Show the standings" />
                </StackPanel>
                <ui:RowList x:Name="StandingsList" ItemsSource="{Binding Standings}" Margin="0,6,0,0" Visibility="Collapsed"
                            AutomationProperties.Name="The board, by place">
                    <ui:RowList.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Place}" Style="{StaticResource Muted}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Yours}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource CyanBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding Points}" Style="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0" />
                                <TextBlock Grid.Column="3" Text="{Binding Gap}" Style="{StaticResource Muted}" FontSize="12"
                                           TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ui:RowList.ItemTemplate>
                </ui:RowList>
            </StackPanel>
            <TextBlock x:Name="PanelNote" Text="{Binding Head.Note}" Style="{StaticResource PanelNoteText}"
                       Visibility="{Binding Head.HasNote, Converter={StaticResource BoolToVisible}}" />
        </StackPanel>
    </Border>
</UserControl>
