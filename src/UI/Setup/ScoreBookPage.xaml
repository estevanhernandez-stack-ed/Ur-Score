<UserControl x:Class="Labs626.UrScore.UI.ScoreBookPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Labs626.UrScore.UI">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="Score book" Style="{StaticResource Heading}" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14"
                   Text="Every successful read is kept on this PC: your own accounts' numbers and each source's headline. Nothing is thinned or deleted, and removing a recipe keeps its book." />

        <TextBlock Text="FOLDER" Style="{StaticResource SectionLabel}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="BookFolderLine" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button x:Name="OpenBookFolderButton" Grid.Column="1" Content="Open folder" Margin="12,0,0,0" Click="OnOpenFolderClick" />
        </Grid>
        <!-- Open folder's own line: no redraw writes it (backlog S1-12.4). -->
        <TextBlock x:Name="BookFolderProblemLine" Style="{StaticResource Refusal}" Margin="0,6,0,0" Visibility="Collapsed" />
        <TextBlock x:Name="BookPendingLine" Style="{StaticResource Muted}" Margin="0,6,0,0" Visibility="Collapsed" />

        <!-- The stats travel as one file (BookPack): the score book and a manifest, never a key. Another PC's book
             joins this one on import: every machine mints its own source ids, so readings are matched to a source by
             its recipe and the clan it follows, never by an id this PC has never seen. -->
        <TextBlock Text="EXPORT AND IMPORT STATS" Style="{StaticResource SectionLabel}" Margin="0,20,0,6" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                   Text="Ran Ur Score on another PC? Export its stats there to one file, then import that file here, and the two become one history. The file holds the score book alone — your own accounts' numbers and each source's headline — and never a key." />
        <StackPanel Orientation="Horizontal">
            <Button x:Name="ExportStatsButton" Content="Export stats…" Click="OnExportStatsClick"
                    AutomationProperties.Name="Export stats to a file for another PC" />
            <Button x:Name="ImportStatsButton" Content="Import stats…" Margin="8,0,0,0" Click="OnImportStatsClick"
                    AutomationProperties.Name="Import stats from another PC's file" />
            <TextBlock x:Name="StatsTransferLine" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="480" />
        </StackPanel>
        <TextBlock x:Name="StatsTransferProblemLine" Style="{StaticResource Refusal}" Margin="0,6,0,0" Visibility="Collapsed" />

        <TextBlock Text="PER RECIPE" Style="{StaticResource SectionLabel}" Margin="0,20,0,6" />
        <TextBlock x:Name="BookLoadingLine" Style="{StaticResource Muted}" Visibility="Collapsed" Text="Reading your score book…" />
        <ui:RowList x:Name="BookRecipesList" AutomationProperties.Name="What the score book keeps for each recipe">
            <ui:RowList.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ui:RowList.ItemTemplate>
        </ui:RowList>

        <TextBlock Text="NOT RECORDING" Style="{StaticResource SectionLabel}" Margin="0,20,0,6" />
        <ui:RowList x:Name="NotRecordingList" AutomationProperties.Name="Sources that are not recording, and why">
            <ui:RowList.ItemTemplate>
                <DataTemplate>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                        <Run Text="{Binding Source, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" · " Foreground="{DynamicResource MutedTextBrush}" />
                        <Run Text="{Binding Reason, Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}" />
                    </TextBlock>
                </DataTemplate>
            </ui:RowList.ItemTemplate>
        </ui:RowList>
        <TextBlock x:Name="AllRecordingLine" Style="{StaticResource Muted}" Visibility="Collapsed" Text="Every source is recording." />
    </StackPanel>
</UserControl>
